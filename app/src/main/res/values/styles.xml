<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo base namespace DP -->
    <style name="DP" />

    <!-- Textos -->
    <style name="DP.Title">
        <item name="android:textColor">@color/dp_navy</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DP.Section">
        <item name="android:textColor">@color/dp_navy</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="DP.Body">
        <item name="android:textColor">@color/dp_gray</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="DP.Link">
        <item name="android:textColor">@color/dp_orange</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">4dp</item>
    </style>
    <style name="DP.Badge">
        <item name="android:textColor">@color/dp_white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <!-- Contenedores -->
    <style name="DP.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- Botones -->
    <style name="DP.Button" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/dp_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="DP.Button.Primary">
        <item name="backgroundTint">@color/dp_orange</item>
    </style>
    <style name="DP.Button.Navy">
        <item name="backgroundTint">@color/dp_navy</item>
    </style>

    <!-- Campos de texto -->
    <style name="DP.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <!-- Chips -->
    <style name="DotaChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:checkable">true</item>
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipStrokeColor">#D5DCE8</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
